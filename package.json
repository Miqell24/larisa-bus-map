{
  "name": "larisa-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Larisa public transport (18 bus lines of Αστικό ΚΤΕΛ Λάρισας) — GTFS synthesised from the citybus.gr passenger API + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "feed": "node pipeline/citybus-feed.mjs",
    "build": "node --max-old-space-size=4096 pipeline/build.mjs --all",
    "lines": "node --max-old-space-size=4096 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=4096 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8179"
  }
}
